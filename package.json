{
  "name": "silva",
  "version": "1.0.0",
  "description": "SILVA — 心理戦カードゲーム",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node test/rules.test.js && node test/server.test.js && node test/online.test.js",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy": "wrangler deploy",
    "check:worker": "wrangler deploy --dry-run",
    "types": "wrangler types",
    "test:cloudflare": "node test/cloudflare.test.cjs",
    "build:pages": "node scripts/build-pages.mjs",
    "deploy:pages": "cd pages && wrangler pages deploy ../dist --project-name silva-online-next --branch main",
    "test:browser": "node test/browser.cjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "uuid": "^13.0.0",
    "ws": "^8.19.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "@playwright/test": "^1.63.0",
    "wrangler": "^4.135.0"
  }
}
