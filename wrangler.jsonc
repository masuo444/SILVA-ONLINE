{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "silva-online-next",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/ping", "/", "/index.html", "/rules.html", "/robots.txt", "/sitemap.xml"] },
  "durable_objects": { "bindings": [
    { "name": "ROOMS", "class_name": "GameRoom" },
    { "name": "LOBBIES", "class_name": "Lobby" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom", "Lobby"] }],
  "observability": { "enabled": true }
}
